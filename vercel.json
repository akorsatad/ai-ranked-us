{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "artifacts/ai-rank/dist/public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "artifacts/{api-server/assets,ai-rank/dist/public}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/industry/:id", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/internal/cron/daily-survey", "schedule": "0 * * * *" }
  ]
}
